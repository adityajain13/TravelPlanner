{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplanner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "adityajain.ca/travelplanner*", "zone_name": "adityajain.ca" }],

  "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "travelplanner-archive" }],

  "triggers": { "crons": ["17 8 * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelplanner",
      "database_id": "e08b728f-206f-4032-91b3-96e852f1c41e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRIP_ROOM", "class_name": "TripRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }],

  "send_email": [{ "name": "EMAIL" }],

  "keep_vars": true,
  "vars": {
    "MAIL_FROM": "trips@adityajain.ca",
    "EXTRACT_MODEL": "claude-haiku-5-5"
  }
}
