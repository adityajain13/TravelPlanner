{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplanner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // More specific than the personal site's adityajain.ca/* route, so it wins for this path.
  "routes": [{ "pattern": "adityajain.ca/travelplanner*", "zone_name": "adityajain.ca" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travelplanner",
      // `npx wrangler d1 create travelplanner`, then paste the id here
      "database_id": "e08b728f-206f-4032-91b3-96e852f1c41e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TRIP_ROOM", "class_name": "TripRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TripRoom"] }],

  // Login codes + import receipts via Email Routing (free plan). Only delivers to verified
  // destination addresses in Email Routing, i.e. the owner's own inbox.
  "send_email": [{ "name": "EMAIL" }],

  // Keep variables added in the dashboard when GitHub Actions deploys (secrets are always kept)
  "keep_vars": true,
  "vars": {
    "MAIL_FROM": "trips@adityajain.ca",
    "EXTRACT_MODEL": "claude-haiku-5-5"
  }
  // Secrets (set in the Cloudflare dashboard → Workers → travelplanner → Settings → Variables and Secrets):
  //   ALLOWED_EMAILS  comma-separated emails allowed to log in
  //   SHARE_SECRET    any long random string (signs share links)
  //   ANTHROPIC_API_KEY  Claude API key for reading forwarded booking emails
  //   UNSPLASH_ACCESS_KEY  optional: Unsplash app Access Key for travel-quality photos in the picker
  //   NAVITIME_RAPIDAPI_KEY  optional: RapidAPI key subscribed to "NAVITIME Route(totalnavi)" for Japanese train routes
}
