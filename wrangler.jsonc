{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travelplanner",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "adityajain.ca/travelplanner*", "zone_name": "adityajain.ca" }]
}
