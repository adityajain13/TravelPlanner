{
  "name": "travelplanner",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "cf:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply travelplanner --remote",
    "db:migrate:local": "wrangler d1 migrations apply travelplanner --local"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityajain13/travelplanner.git"
  },
  "bugs": {
    "url": "https://github.com/adityajain13/travelplanner/issues"
  },
  "homepage": "https://github.com/adityajain13/travelplanner#readme",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fractional-indexing": "^4.0.0",
    "lib0": "^0.2.119",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "nanoid": "^6.0.2",
    "pdfjs-dist": "^6.4.299",
    "postal-mime": "^4.1.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}
